<!DOCTYPE html>
<html data-theme="" lang="<%= config.language %>">
<head>
    <%- partial('_partial/head') %>
</head>
<body>
    <%- partial('_partial/header') %>
    <div class="drawer lg:drawer-open">
        <input id="my-drawer-3" type="checkbox" class="drawer-toggle" />
        <div class="drawer-side">
            <label for="my-drawer-3" aria-label="close sidebar" class="drawer-overlay"></label>
            <div class="site-sidebar flex min-h-dvh w-80 flex-col gap-2 bg-base-300 px-8 pt-8 pb-6 text-base-content lg:pt-16">
                <div class="mx-auto">
                    <div class="avatar pb-1">
                      <div class="w-36 rounded-full">
                        <img alt="<%= config.author %> 的头像" src="<%- url_for('images/icons/icon-284x284.png') %>" width="144" height="144" />
                      </div>
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="text-xl font-normal mx-auto">
                        <%= config.author %>
                    </div>
                    <div class="text-base font-light mx-auto">
                        <%= config.subtitle %>
                    </div>
                    <% if (Array.isArray(theme.social_links) && theme.social_links.length) { %>
                    <div class="flex flex-wrap justify-center gap-2" aria-label="个人链接">
                        <% theme.social_links.forEach(function(link) { %>
                        <a
                          class="btn btn-ghost btn-circle"
                          href="<%- url_for(link.url) %>"
                          aria-label="<%= link.name %>"
                          title="<%= link.name %>"
                        >
                            <span class="lucide-icon text-2xl" style="--lucide-mask: url('<%- url_for('images/lucide/' + link.icon + '.svg') %>')" aria-hidden="true"></span>
                        </a>
                        <% }); %>
                    </div>
                    <% } %>
                    <nav class="mt-2" aria-label="主导航">
                        <%- partial('_partial/menu') %>
                    </nav>
                </div>
                <div class="site-sidebar-appearance mt-auto flex justify-center pt-6">
                    <%- partial('_partial/theme-toggle') %>
                </div>
            </div>
        </div>
        <div class="drawer-content bg-base-200 flex flex-col">          
        <!-- Page content here -->
        <!-- Page Content-->
        <main class="flex-1 min-h-[85vh] w-full px-0 py-0 md:px-4 md:py-4">
            <%- body %>             
        </main>
        <%- partial('_partial/footer') %>
        <!-- Page Content结束-->
        </div>        
    </div>
    <script src="<%- url_for('js/theme-controls.js') %>"></script>
</body>
</html>
