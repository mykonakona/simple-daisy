<!DOCTYPE html>
<html class="[scrollbar-gutter:stable]" data-theme="" lang="<%= config.language %>">
<head>
    <%- partial('_partial/head') %>
</head>
<body class="site-layout bg-base-200 text-base-content">
    <%- partial('_partial/header') %>
    <div class="mx-auto min-h-[calc(100svh-4rem)] w-full max-w-[89rem] lg:grid lg:min-h-screen lg:grid-cols-[20rem_minmax(0,1fr)]">
        <aside class="hidden min-w-0 bg-base-300 lg:block" aria-label="作者与导航">
            <div class="flex flex-col gap-2 px-8 pt-16 pb-6 lg:sticky lg:top-0 lg:max-h-dvh">
              <div class="flex min-h-0 flex-col gap-2 overflow-y-auto overscroll-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div class="mx-auto shrink-0">
                    <div class="avatar pb-1">
                      <div class="w-36 rounded-full">
                        <img alt="<%= config.author %> 的头像" src="<%- url_for('images/icons/icon-284x284.png') %>" width="144" height="144" />
                      </div>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 flex-col gap-1">
                    <a class="text-center text-xl font-normal wrap-anywhere" href="<%- url_for('/') %>"><%= config.author %></a>
                    <% if (config.subtitle) { %>
                    <p class="text-center text-base font-light leading-normal text-base-content/70 wrap-anywhere"><%= config.subtitle %></p>
                    <% } %>
                    <% if (Array.isArray(theme.social_links) && theme.social_links.length) { %>
                    <div class="mx-auto flex w-fit max-w-full items-center gap-1 overflow-x-auto overscroll-x-contain [scrollbar-width:thin]" aria-label="个人链接">
                        <% theme.social_links.forEach(function(link) { %>
                        <a
                          class="group btn btn-ghost btn-circle size-9 min-h-9 shrink-0 p-0 hover:text-primary focus-visible:text-primary"
                          href="<%- url_for(link.url) %>"
                          aria-label="<%= link.name %>"
                          title="<%= link.name %>"
                        >
                            <span class="lucide-icon text-2xl motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-out motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:scale-110 motion-safe:group-focus-visible:-translate-y-0.5 motion-safe:group-focus-visible:scale-110" style="--lucide-mask: url('<%- url_for('images/lucide/' + link.icon + '.svg') %>')" aria-hidden="true"></span>
                        </a>
                        <% }); %>
                    </div>
                    <% } %>
                    <nav class="mt-2" aria-label="主导航">
                        <%- partial('_partial/menu') %>
                    </nav>
                </div>
              </div>
                <div class="flex shrink-0 justify-center pt-3">
                    <%- partial('_partial/theme-toggle') %>
                </div>
            </div>
        </aside>
        <div class="mx-auto flex min-h-[calc(100svh-4rem)] w-full min-w-0 flex-col lg:min-h-screen lg:max-w-[69rem]">
            <main class="min-w-0 w-full flex-1 px-4 py-5 sm:p-6 lg:p-8">
                <div class="mx-auto w-full min-w-0 max-w-[52rem] lg:max-w-none">
                    <%- body %>
                </div>
            </main>
            <%- partial('_partial/footer') %>
        </div>
    </div>
    <script src="<%- url_for('js/theme-controls.js') %>"></script>
</body>
</html>
