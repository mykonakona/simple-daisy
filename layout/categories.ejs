<div class="w-full min-w-0">
  <section class="card min-w-0 border border-base-content/5 bg-base-100 shadow-sm" aria-label="文章分类">
    <div class="card-body min-w-0 p-5 sm:p-6 lg:p-8">
      <% if (site.categories.length) { %>
      <ul class="menu w-full min-w-0 p-0 text-base">
        <%- partial('_partial/category-menu', {categories: site.categories.sort('name', 1).toArray(), parent: null}) %>
      </ul>
      <% } else { %>
      <p class="text-base-content/65">暂无分类。</p>
      <% } %>
    </div>
  </section>
</div>


