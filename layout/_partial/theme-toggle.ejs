<div class="join" role="group" aria-label="外观模式">
  <button type="button" class="join-item btn btn-ghost size-11 min-h-11 shrink-0 p-0 text-xl" data-theme-choice="light" aria-label="浅色模式" aria-pressed="false">
    <span class="lucide-icon" style="--lucide-mask: url('<%- url_for('images/lucide/sun.svg') %>')" aria-hidden="true"></span>
  </button>
  <button type="button" class="join-item btn btn-ghost size-11 min-h-11 shrink-0 p-0 text-xl" data-theme-choice="dark" aria-label="深色模式" aria-pressed="false">
    <span class="lucide-icon" style="--lucide-mask: url('<%- url_for('images/lucide/moon.svg') %>')" aria-hidden="true"></span>
  </button>
</div>
