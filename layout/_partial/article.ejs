<% if (index) { %>
<div class="card bg-base-100 rounded-box transition-all duration-500 ease-in-out hover:z-30 hover:shadow-lg md:shadow-xl md:hover:shadow-2xl md:hover:-translate-y-0.5">
  <div class="card-body min-h-60">
    <h2 class="card-title">
      <a href="<%- url_for(post.link ? post.link : post.path) %>" itemprop="url"><%= post.title %></a>
    </h2>
    <% if (post.excerpt) { %>
    <div class="min-h-10 mb-2">
      <%- post.excerpt %>
    </div>
    <% } %>
    <div class="card-actions justify-end mt-auto">
      <i class="hgi hgi-stroke hgi-calendar-03"></i>
      <p class="text-sm text-gray-500">
        <%- date(post.date, 'YYYY-MM-DD') %>
      </p>
      <%- list_tags(post.tags, {class: {a: 'badge badge-secondary text-base-100'}, show_count: false, style: false, separator: ' '}) %>
    </div>
  </div>
</div>
<% } else { %>
<div class="mx-auto p-4">
  <div class="card mx-auto bg-base-100 max-w-5xl">
    <div class="card-body w-full mx-auto">
      <article class="prose max-w-5xl pb-4 text-base prose-h2:mt-0 prose-h2:mb-2 md:text-lg">
        <div class="mb-4 text-2xl font-bold"><%= post.title %></div>

        <div class="mb-2 text-sm text-gray-500">
          发布于 <%- date(post.date, 'YYYY-MM-DD HH:mm:ss') %>
        </div>

        <div class="mb-2 text-sm text-gray-500">
          阅读时长:约 <%= Math.ceil(post.content.split(' ').length / 200) %> 分钟
        </div>

        <div class="text-base md:text-lg">
          <%- post.content %>
        </div>
      </article>

      <%- partial('_partial/giscus') %>
    </div>
  </div>

  <aside class="hidden lg:block fixed top-24 z-40
               right-[max(1rem,calc((100vw-80rem)/2-16rem-4rem))]
               w-64">
    <div class="max-h-[calc(100vh-7rem)] overflow-auto pr-1">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm font-semibold opacity-80">目录</span>
        <div class="divider m-0 flex-1"></div>
      </div>

      <nav>
        <%
      const rawToc = toc(post.content, { list_number: false, min_depth: 2, max_depth: 4 }) || '';
  
      const treeToc = rawToc
        // 子目录：树状缩进 + 左竖线（你现在的树状就是靠这个）
        .replace(/class="([^"]*\btoc-child\b[^"]*)"/g,
          'class="$1 ml-3 pl-3 border-l border-base-300/70 space-y-1"'
        )
        // 链接：用 daisyUI 按钮(ghost)来获得“悬浮像按钮”的效果
        .replace(/class="([^"]*\btoc-link\b[^"]*)"/g,
          'class="$1 btn btn-ghost btn-sm w-full justify-start text-left normal-case px-2"'
        )
        // 外层容器稍微收紧一下
        .replace(/class="([^"]*\btoc\b[^"]*)"/g,
          'class="$1 text-sm leading-6 space-y-1"'
        );
    %>
        <%- treeToc %>
      </nav>

    </div>
  </aside>
</div>

<% } %>