<% if (page.total > 1){ %>
    <nav class="mx-4 my-6" aria-label="分页">
        <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 sm:hidden">
            <% if (page.prev) { %>
            <a class="btn btn-ghost justify-self-start" rel="prev" href="<%- url_for(page.prev_link) %>">上一页</a>
            <% } else { %>
            <span class="btn btn-ghost btn-disabled justify-self-start" aria-disabled="true">上一页</span>
            <% } %>
            <span class="text-sm tabular-nums" aria-current="page"><%= page.current %> / <%= page.total %></span>
            <% if (page.next) { %>
            <a class="btn btn-ghost justify-self-end" rel="next" href="<%- url_for(page.next_link) %>">下一页</a>
            <% } else { %>
            <span class="btn btn-ghost btn-disabled justify-self-end" aria-disabled="true">下一页</span>
            <% } %>
        </div>
        <div class="hidden sm:flex justify-center">
            <div class="join">
                <%- paginator({
                    prev_text: "上一页",
                    next_text: "下一页",
                    mid_size: 1,
                    page_class: "join-item btn",
                    prev_class: "join-item btn",
                    next_class: "join-item btn",
                    current_class : "join-item btn btn-active",
                    escape: false
                  }) %>
            </div>
        </div>
    </nav>
<% } %>
