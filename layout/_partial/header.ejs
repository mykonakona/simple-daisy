<header class="site-header sticky top-0 z-40 bg-base-200 lg:hidden">
  <nav class="navbar gap-3 px-4" aria-label="手机导航">
    <a class="btn btn-ghost btn-square size-11 shrink-0" href="<%- url_for('/about/') %>" aria-label="关于 <%= config.author %>">
      <img class="rounded-full" src="<%- url_for('images/icons/icon-152x152.png') %>" alt="" width="36" height="36" />
    </a>
    <a class="min-w-0 flex-1 truncate text-center text-lg font-medium" href="<%- url_for('/') %>"><%= config.author %></a>
    <details class="mobile-menu dropdown dropdown-end group shrink-0">
      <summary class="btn btn-ghost btn-square size-11 text-2xl" aria-label="打开导航菜单">
        <span class="lucide-icon group-open:hidden" style="--lucide-mask: url('<%- url_for('images/lucide/menu.svg') %>')" aria-hidden="true"></span>
        <span class="lucide-icon hidden group-open:inline-block" style="--lucide-mask: url('<%- url_for('images/lucide/x.svg') %>')" aria-hidden="true"></span>
      </summary>
      <div class="mobile-menu-panel dropdown-content mt-2 w-56 max-w-[calc(100vw-2rem)] overflow-y-auto overscroll-contain bg-base-200 rounded-box p-2 shadow-lg">
        <%- partial('_partial/menu') %>
        <div class="flex justify-center pt-3">
          <%- partial('_partial/theme-toggle') %>
        </div>
      </div>
    </details>
  </nav>
</header>
