<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  const seoTitle = page.title ? (page.title + ' - ' + config.title) : config.title;
  const seoDescription = strip_html(page.description || page.excerpt || config.description || config.subtitle || config.title);
  const canonicalUrl = page.permalink || full_url_for(is_home() ? page.current_url : (page.path || ''));
%>
<title><%= seoTitle %></title>
<link rel="icon" type="image/x-icon" href="<%= url_for('images/icons/favicon.ico') %>">
<link rel="canonical" href="<%= canonicalUrl %>">
<%- open_graph({ title: seoTitle, description: seoDescription, url: canonicalUrl }) %>
<script>
  (() => {
    const appearance = window.simpleDaisyAppearance = <%- JSON.stringify(appearance_config()).replace(/</g, '\\u003c') %>;
    const preferredMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    let savedMode;
    try {
      savedMode = localStorage.getItem('simple-daisy-theme');
    } catch (error) {
      console.warn('Unable to restore the saved color theme.', error);
    }
    // Migrate previously saved theme names to a light/dark preference.
    if (savedMode !== 'light' && savedMode !== 'dark') {
      if (savedMode === appearance.light) savedMode = 'light';
      else if (savedMode === appearance.dark) savedMode = 'dark';
    }
    const mode = savedMode === 'light' || savedMode === 'dark' ? savedMode : preferredMode;
    document.documentElement.dataset.theme = appearance[mode];
  })();
</script>
<%- css(['css/main.css']) %> 
<link rel="preload" href="https://webfonts-seven.vercel.app/noto-sans-sc-v36-chinese-simplified_latin-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= prism_stylesheet() %>"/>
