<%
  const taxonomy = page.category
    ? site.categories.findOne({name: page.category})
    : page.tag ? site.tags.findOne({name: page.tag}) : null;
  const archivePeriod = [page.year, page.month && String(page.month).padStart(2, '0'), page.day && String(page.day).padStart(2, '0')].filter(Boolean).join(' / ');
%>
<div class="@container w-full min-w-0">
  <% if (page.category || page.tag || page.year) { %>
  <nav class="breadcrumbs mb-4 max-w-full pt-0 text-sm text-base-content/65" aria-label="当前位置">
    <ul>
      <li><a href="<%- url_for((page.category ? config.category_dir : page.tag ? config.tag_dir : config.archive_dir) + '/') %>"><%= page.category ? '分类' : page.tag ? '标签' : '归档' %></a></li>
      <li aria-current="page"><%= page.category || page.tag || archivePeriod %></li>
    </ul>
  </nav>
  <% } %>

  <% if (taxonomy || config.archive == 2) { %>
  <div class="grid grid-cols-1 gap-4 sm:gap-6 @[36rem]:grid-cols-2">
    <% page.posts.each(function(post) { %>
      <%- partial('_partial/article', {post: post, index: true}) %>
    <% }) %>
  </div>
  <% } else { %>
  <div class="space-y-4 sm:space-y-6">
    <% let lastYear; %>
    <% page.posts.each(function(post) { %>
      <% const year = post.date.year(); %>
      <% if (lastYear !== year) { %>
        <% if (lastYear != null) { %>
          </ul></div></section>
        <% } %>
        <% lastYear = year; %>
        <section class="card min-w-0 border border-base-content/5 bg-base-100 shadow-sm" aria-labelledby="archive-year-<%= year %>">
          <div class="card-body min-w-0 gap-3 p-5 sm:p-6">
            <h2 id="archive-year-<%= year %>" class="card-title text-xl">
              <% if (config.archive_generator && config.archive_generator.yearly) { %>
              <a class="link link-hover" href="<%- url_for(config.archive_dir + '/' + year + '/') %>"><%= year %></a>
              <% } else { %>
              <%= year %>
              <% } %>
            </h2>
            <ul class="list">
      <% } %>
              <li>
                <a class="list-row items-baseline gap-3 text-base hover:bg-base-200 focus-visible:bg-base-200 sm:gap-5" href="<%- url_for(post.link ? post.link : post.path) %>">
                  <time class="shrink-0 text-sm text-base-content/65 tabular-nums" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM-DD') %></time>
                  <span class="min-w-0 leading-relaxed wrap-anywhere"><%= post.title %></span>
                </a>
              </li>
    <% }) %>
    <% if (page.posts.length) { %>
          </ul></div></section>
    <% } %>
  </div>
  <% } %>

  <% if (!page.posts.length) { %>
  <div class="card border border-base-content/5 bg-base-100 shadow-sm">
    <div class="card-body p-5 text-base-content/65 sm:p-6">暂无文章。</div>
  </div>
  <% } %>
  <% if (page.total > 1) { %>
    <%- partial('_partial/paginator') %>
  <% } %>
</div>
