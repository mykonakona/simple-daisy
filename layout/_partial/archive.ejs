<article class="@container w-full min-w-0">
<% if (pagination == 2){ %>
    <div class="grid grid-cols-1 gap-6 @[36rem]:grid-cols-2">
    <% page.posts.each(function(post){ %>
      <%- partial('_partial/article', {post: post, index: true}) %>
    <% }) %>
    </div>
  <% } else { %>
    <% var last; %>
    <% page.posts.each(function(post, i){ %>
      <% var year = post.date.year(); %>
      <% if (last != year){ %>
        <% if (last != null){ %>
          </div></section>
        <% } %>
        <% last = year; %>
        <section class="archives-wrap mb-6">
            <div class="archive-year-wrap mb-2 text-sm text-base-content/65">
                <a href="<%- url_for(config.archive_dir + '/' + year) %>" class="archive-year"><%= year %></a>
            </div>
            <div class="archives">
      <% } %>
            <div class="py-3 text-2xl font-bold leading-snug wrap-anywhere sm:text-3xl">
                <a class="link link-hover" href="<%- url_for(post.link ? post.link : post.path) %>" itemprop="url"><%= post.title %></a>
            </div>
    <% }) %>
    <% if (page.posts.length){ %>
      </div></section>
    <% } %>
  <% } %>
  <% if (page.total > 1) { %>
	<%- partial('_partial/paginator') %>
<% } %>        
</article>
